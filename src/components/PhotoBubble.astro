---
import { Image, getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import Tail from "./Tail.astro"

/**
 * A picture she sent with a milestone, as a photo message. When it ends a run
 * it carries the tail, coloured like the photo's bottom-left corner (see
 * src/scripts/photo-tails.ts). Tapping opens the full image.
 */
interface Props {
  image: ImageMetadata
  alt: string
  tail?: boolean
}

const { image, alt, tail = false } = Astro.props
const full = await getImage({ src: image, width: Math.min(image.width, 1600) })
---

<li class="row row-her">
  <a class="bubble bubble-flush photo" href={full.src} target="_blank" rel="noopener noreferrer" data-photo>
    <Image src={image} alt={alt} widths={[340, 680, 1020]} sizes="(min-width: 640px) 340px, 66vw" />
    {tail && <Tail class="tail-pending" />}
  </a>
</li>
