---
/**
 * A small glass button in the bottom-right corner that takes you back to the
 * top of the conversation. It appears once her greeting is out of view.
 */
---

<button type="button" class="glass to-top" aria-label="Back to top" tabindex="-1" aria-hidden="true">
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3.5 10 8 5.5l4.5 4.5"></path>
  </svg>
</button>

<script>
  import { prefersReducedMotion } from "@/lib/spring"

  const button = document.querySelector<HTMLButtonElement>(".to-top")
  const intro = document.querySelector(".intro")
  if (button && intro) {
    new IntersectionObserver(([entry]) => {
      const visible = !entry.isIntersecting && entry.boundingClientRect.top < 0
      button.classList.toggle("is-visible", visible)
      button.tabIndex = visible ? 0 : -1
      button.setAttribute("aria-hidden", String(!visible))
    }).observe(intro)
    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" })
      document.querySelector<HTMLElement>("main h1")?.focus({ preventScroll: true })
    })
  }
</script>
